# .quickrobot.env.sample — Template for quickrobot configuration
# Copy to .quickrobot.env and fill in production values.
# Format: KEY=value (plain text, no quotes needed for simple values)
# IPv6-compatible: use [addr] bracket notation where applicable
# Example: QUICKROBOT_API_HOST=[::1] for IPv6 loopback

# --- Startup & Lifecycle ---

# Autostart system engines on API startup (default: true)
QUICKROBOT_WEBUI_AUTOSTART=true
QUICKROBOT_MCP_AUTOSTART=true
QUICKROBOT_SCHEDULER_AUTOSTART=true

# Orphaned process adopt on API restart:
#   true  → keep old process (SSE session survives for MCP)
#   false → kill + restart with new code (safer during dev)
# WebUI default: false, MCP default: true, Scheduler default: false
QUICKROBOT_WEBUI_RESTART_ADOPT=false
QUICKROBOT_MCP_RESTART_ADOPT=true
QUICKROBOT_SCHEDULER_RESTART_ADOPT=false

# Seconds to wait for old process exit before killing (default: 5)
QUICKROBOT_SERVER_SPAWN_TIMEOUT=5

# Health check retry count — applies to WebUI, MCP threads, Scheduler
# Default: 2
QUICKROBOT_SYSTEM_RETRIES=2

# --- API Server ---

# Bind address and port (default: 127.0.0.1:8039)
QUICKROBOT_API_HOST=127.0.0.1
QUICKROBOT_API_PORT=8039

# CORS origins for /api/v1/* routes. Comma-separated full origin URLs or "*"
# Default: * (all origins allowed — LAN mode)
QUICKROBOT_API_CORS_ORIGINS=*

# Ansible SSH credentials (empty = use defaults from qr_engine_ids.py)
# QUICKROBOT_API_ANSIBLE_SSHUSER=mepaw
# QUICKROBOT_API_ANSIBLE_SSHKEY=/home/user/.ssh/id_ed25519

# Display-only ping command for node reachability checks (default: ping -c1 -W2 {host})
QUICKROBOT_API_PING_COMMAND=ping -c1 -W2 {host}

# Seconds between ping checks (default: 120)
QUICKROBOT_API_PING_INTERVAL=120

# Default model root path for new nodes on creation. Override per-node via API.
# Default: /opt/quickrobot/models
# QUICKROBOT_API_MODEL_BASE_PATH=/opt/quickrobot/models

# Playbook directory path (default: playbooks/)
QUICKROBOT_API_PLAYBOOKDIR=playbooks/

# --- WebUI ---

# Bind address and port (default: 127.0.0.1:8038)
QUICKROBOT_WEBUI_HOST=127.0.0.1
QUICKROBOT_WEBUI_PORT=8038

# Single-user login password. When set, WebUI shows login page.
# Empty/missing = no login required (legacy LAN-only mode).
# Default: empty (no auth)
QUICKROBOT_WEBUI_PASSWORD=CHANGE_ME

# Login rate limiter — per-IP failed attempt tracking with exponential backoff.
# Max attempts before block (default: 5), initial backoff in seconds (default: 10),
# max backoff cap in seconds (default: 300)
QUICKROBOT_WEBUI_RATE_LIMIT=5
QUICKROBOT_WEBUI_RATE_BASE_DELAY=10
QUICKROBOT_WEBUI_RATE_MAX_DELAY=300

# --- MCP Server ---

# Bind address and port (default: 127.0.0.1:8040)
QUICKROBOT_MCP_HOST=127.0.0.1
QUICKROBOT_MCP_PORT=8040

# MCP permission flags — set dynamically in WebUI if needed:
#   READ=true      → list/summary tools + benchmark start
#   WRITE=true     → host/instance create, delete, etc.
#   FULLPROXY=true → all API functions via MCP wrapper
QUICKROBOT_MCP_READ=true
QUICKROBOT_MCP_WRITE=true
QUICKROBOT_MCP_FULLPROXY=true

# DNS rebinding protection: true = no validation (dev convenience)
# false = enforce CORS origins from QUICKROBOT_MCP_CORS_ORIGINS
# Default: true
QUICKROBOT_MCP_DISABLE_DNS_REBINDING=true

# Allowed origins for MCP SSE connections (when rebinding check is enabled)
# Comma-separated full origin URLs
# Default: http://127.0.0.1:8080,http://localhost:8080
QUICKROBOT_MCP_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# --- Auth & Security ---
# WARNING: WITHOUT ENCRYPTION KEYS ARE NOT SECURE IN ANY WAY!

# API key — gates all /api/v1/* routes (API, WebUI proxy, MCP proxy, external agents)
# Format: 43-char URL-safe base64. Prefix convention: QR-API-
# Example: QR-API-asd09asd12345678901234567890abcde
QUICKROBOT_API_KEY=CHANGE_ME

# Disable API key authentication entirely (default: false)
# true = bypass startup FATAL + accept all requests; false = enforce auth
# NOTE: .sample MUST have this set to false. Fresh install flow generates a real
# API key and sets it in .env. The .sample file holds no secrets but enables
# security on default deployment — keys get set during initialization.
QUICKROBOT_API_KEY_DISABLED=false

# MCP SSE token — gates the /sse endpoint on port 8040.
# Falls back to QUICKROBOT_API_KEY if not set (backward compat).
# Format: 43-char URL-safe base64. Prefix convention: QR-MCP-
# Example: QR-MCP-8437309abcdef1234567890abcdef12345678
QUICKROBOT_MCP_TOKEN=CHANGE_ME

# Disable MCP SSE token authentication (default: false)
# true = all SSE requests pass; false = enforce token
QUICKROBOT_MCP_KEY_DISABLED=false

# --- Logging ---

# Per-engine log level — 0 = quiet production, >=10 = verbose debug
# QUICKROBOT_<ENGINE>_LOG_LEVEL overrides the global console level.
# Engines: scheduler, mcp, webui, api
# Default per-engine: inherits from QUICKROBOT_CONSOLE_DEBUG_LEVEL (10)
QUICKROBOT_SCHEDULER_LOG_LEVEL=10
QUICKROBOT_MCP_LOG_LEVEL=0
QUICKROBOT_WEBUI_LOG_LEVEL=0
QUICKROBOT_API_LOG_LEVEL=10

# Global console debug level — fallback when per-engine key is absent (default: 10)
QUICKROBOT_CONSOLE_DEBUG_LEVEL=10

# Ansible DB log level — what gets persisted to ansible_actions table
# options: errors (failures/timeouts only), warnings (+ non-failed changes), all
# Default: errors
QUICKROBOT_ANSIBLE_LOG_LEVEL=all

# --- Data Integrity ---

# Seed file SHA256 checksum and file size for verification on fresh DB creation.
# SOURCE OF TRUTH: these are real values from the seed file, not CHANGE_ME placeholders.
# Fresh install flow (ensure_db_and_env) copies .sample -> .env without replacing these.
# pre_validate_seed_checksum() compares them against the actual seed file — mismatch = FATAL.
# On development changes to seed: update both .sample AND .env with new values.
QUICKROBOT_SEED_CHECKSUM=c861c67fdbaa1104153a892850b4bd7fb7b08b3984bf66838ac9714f11b406b5
QUICKROBOT_SEED_FILESIZE=42451

# Max auto-incremented ID from seed — prevents conflicts with real DB IDs
# Default: 1000
QUICKROBOT_SEED_MAX_ID=1000

# --- Cleanup & Retention ---

# Remove orphaned nodes/instances on creation failure (default: true)
# false = keep partial records for debugging
QUICKROBOT_CLEANUP_ON_CREATE_FAIL=true

# Database backup retention in data/_backups/ (default: 5)
# 0 = keep all backups
QUICKROBOT_MAX_BACKUPS=10

# Auto-cleanup completed/failed log entries on API startup, in days.
# 0 = disable auto-cleanup. Default: 30
QUICKROBOT_LOG_RETENTION_DAYS=7

# Redirect all __pycache__ to single location (Python 3.8+).
# Empty string disables (default: per-directory __pycache__)
PYTHONPYCACHEPREFIX=/tmp/pycache

# --- SSH & Network ---

# SSH strict host key checking: yes (prompt) | accept-new (headless safe) | no (insecure)
# Default: accept-new
QUICKROBOT_SSH_STRICT_HOST_KEY_CHECKING=accept-new

# SSH connection timeout in seconds (default: 5)
QUICKROBOT_SSH_CONNECT_TIMEOUT=5

# IP address family preference when node has both IPv4 and IPv6.
# Values: ipv4 | ipv6. Read once at startup. Default: ipv4
QUICKROBOT_PREFERRED_IP_FAMILY=ipv4

# --- Quicksetup (first-run auto-deploy, v0.10) ---

# Enable guided first-run: hardware scan + instance creation + deploy
# on fresh DB startup (after seed import, before engine auto-start).
# Default: false (manual setup)
QUICKROBOT_QUICKSETUP=false

# Optional HuggingFace model to download during quicksetup.
# Example: google/gemma-3-1b-it-GGUF:Q4_K_M
QUICKROBOT_QUICKSETUP_MODEL=unsloth/Qwen3.6-35B-A3B-MTP-GGUF:Q8_0
