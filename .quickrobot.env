# .quickrobot.env — System engine configuration
# Format: KEY=value (plain text, no quotes needed for simple values)
# IPv6-compatible: use [addr] bracket notation where applicable
# Example: QUICKROBOT_API_HOST=[::1] for IPv6 loopback
#          QUICKROBOT_MCP_HOST=[fe80::1%eth0] for link-local IPv6
#
# Ownership: Human-edited only. No server process writes to this file.
# Single source of truth for system engine network config.
# Missing file = all system engines error out at startup with help text.


# =========================================================================
# WebUI - Ape control interface
# =========================================================================

QUICKROBOT_WEBUI_HOST=127.0.0.1
QUICKROBOT_WEBUI_PORT=8038

QUICKROBOT_WEBUI_AUTOSTART=true
QUICKROBOT_MCP_AUTOSTART=true
QUICKROBOT_SCHEDULER_AUTOSTART=true

# LLAMA_ARG_UI & LLAMA_ARG_UI_MCP_PROXY is used for llama-server instances and enabled in the settings  
# This allows the default UI to use Quickrobot's MCP even if the Browser client is in another subnet:

# =========================================================================
# WebUI User Password — single-user authentication
# =========================================================================
# QUICKROBOT_WEBUI_PASSWORD → if set, WebUI shows login page; user must enter
#   this password before accessing any page. If empty/missing, no login required
#   (legacy LAN-only mode). Plain text, no hashing.
# Example: QUICKROBOT_WEBUI_PASSWORD=MyS3cur3P@ssw0rd
QUICKROBOT_WEBUI_PASSWORD=
# =========================================================================
# API Server - Agent Control interface
# =========================================================================

QUICKROBOT_API_HOST=127.0.0.1
QUICKROBOT_API_PORT=8039

# CORS origins for the main API server (all /api/v1/* routes).
# Comma-separated full origin URLs, or "*" for wildcard (trusted LAN).
# Examples:
#   *                          → all origins allowed (LAN default)
#   http://127.0.0.1:8039      → single origin (loopback only)
#   http://dashboard.lan,https://app.example.com  → explicit allowlist
# When "*", the response header is Access-Control-Allow-Origin: *
# When specific origins, the response echoes back the requesting origin
# (if it matches the allowlist).
QUICKROBOT_API_CORS_ORIGINS=*

# ansible_user (empty = dynamic getpass)
# QUICKROBOT_API_ANSIBLE_SSHUSER=mepaw
# ansible_key_path → QUICKROBOT_API_ANSIBLE_SSHKEY (empty = ssh-agent)
# QUICKROBOT_API_ANSIBLE_SSHKEY=/home/user/.ssh/id_ed25519

# ping_command (only for display)
QUICKROBOT_API_PING_COMMAND=ping -c1 -W2 {host}

# ping_interval 
QUICKROBOT_API_PING_INTERVAL=120

# Model base "scan" path — default model root for nodes/hosts on creation.
# Can be overridden per-node via PUT /api/v1/nodes/<id>.
QUICKROBOT_API_MODEL_BASE_PATH=/opt/quickrobot/models

# =========================================================================
# MCP Server - Chat Control Interface
# =========================================================================

#QUICKROBOT_MCP_HOST=192.168.31.40
QUICKROBOT_MCP_HOST=127.0.0.1
QUICKROBOT_MCP_PORT=8040
QUICKROBOT_MCP_AUTOSTART=true

# Can be set synamic in webui:
# Allow MCP List and Summary tools + start Benchmarks:
QUICKROBOT_MCP_READ=true
# Allow Host and Instance creation, deletion, etc:
QUICKROBOT_MCP_WRITE=true
# Allow all API functions using MCP wrapper:
QUICKROBOT_MCP_FULLPROXY=true

# true  → no validation (dev convenience, all requests pass)
# false → enforce CORS origins from QUICKROBOT_MCP_CORS_ORIGINS; host header accepted (MCP binds to one address anyway)
QUICKROBOT_MCP_DISABLE_DNS_REBINDING=true

# Origin gate: only these origins can connect to the MCP server (when DISABLE_DNS_REBINDING=false).
# Format: comma-separated full origin URLs
# BROKEN/Useless 
QUICKROBOT_MCP_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
#
# =========================================================================
# Auth Token — single gatekeeper for all /api/v1/* routes
# =========================================================================
# QUICKROBOT_API_KEY → accepted on ALL routes (API, WebUI proxy, MCP proxy).
#   One shared key replaces the old three-token model (API_KEY, WEBUI_TOKEN, MCP_TOKEN).
# Format: secrets.token_urlsafe(32) = 43-char URL-safe base64 random string
QUICKROBOT_API_KEY=YFoLkZ1sMlVtXNm5Wq9t33F9x6r4wuke4-gy2A9Akm0

# =========================================================================
# Spawn timeout (seconds)
# Time to wait for old process to exit before killing it during restart.
# Must be an integer >= 1.
# =========================================================================

QUICKROBOT_SERVER_SPAWN_TIMEOUT=5

# =========================================================================
# System engine restart adopt flags (per-engine)
# When orphaned process detected during API restart:
#   true  → keep old process (SSE session survives for MCP, no port conflict for scheduler)
#   false → kill + restart with new code (safer during development)
# =========================================================================

# WebUI: false — no long-lived sessions, safe to always restart
QUICKROBOT_WEBUI_RESTART_ADOPT=false

# MCP: true — preserves SSE session across API restarts
# Set to false during active dev when you want latest MCP code immediately
QUICKROBOT_MCP_RESTART_ADOPT=true

# Scheduler: false during development — ensures latest scheduler code runs after changes
# (Scheduler has no port conflict risk since it doesn't bind a port)
QUICKROBOT_SCHEDULER_RESTART_ADOPT=false

# =========================================================================
# System engine health check retry count
# Controls: WebUI, MCP (health check thread), Scheduler (env layer)
# Values: 1-10. Default: 2
# =========================================================================
QUICKROBOT_SYSTEM_RETRIES=3

# =========================================================================
# WebUI login rate limiter — per-IP failed attempt tracking with exponential backoff
# QUICKROBOT_WEBUI_RATE_LIMIT       max attempts before block (default: 5)
# QUICKROBOT_WEBUI_RATE_BASE_DELAY  initial backoff seconds (default: 10)
# QUICKROBOT_WEBUI_RATE_MAX_DELAY   max backoff cap seconds (default: 300)
# =========================================================================
QUICKROBOT_WEBUI_RATE_LIMIT=5
QUICKROBOT_WEBUI_RATE_BASE_DELAY=10
QUICKROBOT_WEBUI_RATE_MAX_DELAY=300

# =========================================================================
# Logging configuration
# =========================================================================
# Per-engine log level — numeric, 0 = quiet production, >= 10 = verbose debug
# QUICKROBOT_<ENGINE>_LOG_LEVEL overrides QUICKROBOT_CONSOLE_DEBUG_LEVEL.
# Engines: scheduler, mcp, webui, api
# Fallback: if per-engine key absent, uses QUICKROBOT_CONSOLE_DEBUG_LEVEL.
QUICKROBOT_SCHEDULER_LOG_LEVEL=10
QUICKROBOT_MCP_LOG_LEVEL=0
QUICKROBOT_WEBUI_LOG_LEVEL=0
QUICKROBOT_API_LOG_LEVEL=10
# Legacy single console level — deprecated, kept for backward compat
QUICKROBOT_CONSOLE_DEBUG_LEVEL=10
# Ansible action DB log level — "errors" (default), "warnings", "all"
# "errors" only logs failures/timeouts to ansible_actions table.
# "warnings" also logs non-failed changes (apt updates, config-only deploys).
# "all" logs every playbook execution.

QUICKROBOT_ANSIBLE_LOG_LEVEL=all

# =========================================================================
# Seed file verification
# =========================================================================

QUICKROBOT_SEED_CHECKSUM=fd9d73071af840fcb26f64d09faa72943198b42c7e983c96a3996e9bae92229e
QUICKROBOT_SEED_FILESIZE=97630
QUICKROBOT_SEED_MAX_ID=1000

# =========================================================================
# Create-fail cleanup — when true, orphaned nodes/instances are removed
# from DB on creation failure (default: true). When false, legacy behavior:
# partially-created records are kept for debugging.
# =========================================================================

QUICKROBOT_CLEANUP_ON_CREATE_FAIL=true

# =========================================================================
# Python bytecode cache — redirect all __pycache__ to single location
# PYTHONPYCACHEPREFIX is available since Python 3.8
# Set to empty string to disable (default: per-directory __pycache__)
# =========================================================================
PYTHONPYCACHEPREFIX=/tmp/pycache

# =========================================================================
# Database backup retention
# Number of database backup files to keep in data/_backups/ (default: 5)
# Set to 0 to keep all backups.
# =========================================================================
QUICKROBOT_MAX_BACKUPS=10 

# =========================================================================
# Log retention — auto-cleanup completed/failed log entries on API startup
# Number of days to keep log entries (health_check, ansible_execute, etc.)
# Set to 0 to disable auto-cleanup. Default: 30
# =========================================================================

QUICKROBOT_LOG_RETENTION_DAYS=7

# =========================================================================
# SSH connection settings — override defaults from qr_engine_ids.py
# =========================================================================

# Strict host key checking: "yes" (prompt) | "accept-new" (headless safe) | "no" (insecure)
QUICKROBOT_SSH_STRICT_HOST_KEY_CHECKING=accept-new

# SSH connection timeout in seconds
QUICKROBOT_SSH_CONNECT_TIMEOUT=5

# playbook_root_dir → QUICKROBOT_API_PLAYBOOKDIR
QUICKROBOT_API_PLAYBOOKDIR=playbooks/

# =========================================================================
# QUICKSETUP — first-run auto-deploy (v0.10)
# When true, triggers automated hardware scan + instance creation + deploy
# on fresh DB startup (after seed import, before engine auto-start).
# QUICKROBOT_QUICKSETUP_MODEL=<hf_repo_path> — optional HuggingFace model
#   to download (e.g., google/gemma-3-1b-it-GGUF:Q4_K_M)
# Set to true for guided first-run; set to false or omit for manual setup.
# =========================================================================
QUICKROBOT_QUICKSETUP=false
QUICKROBOT_QUICKSETUP_MODEL=unsloth/Qwen3.6-35B-A3B-MTP-GGUF:Q8_0
# WIP
# =========================================================================
# Engine Enable/Disable — whitelist via env keys (startup only)
# Format: QUICKROBOT_ENGINE_<ID>_<name>_ENABLED=true/false
# Keys are read at startup by _is_engine_enabled() in engine/__init__.py.
# Absent or commented-out = loaded (default). Set =false to disable that engine type.
# NOTE: This is a startup-only toggle. Runtime changes require API endpoint (C7 pending).
# NOTE: System-managed engines (api, webui, mcp, scheduler) are NOT controlled by this whitelist.
# Example: disable the iperf3 engine NOT IMPLEMENTED
# QUICKROBOT_ENGINE_31_iperf3_ENABLED=false NOT IMPLEMENTED
# =========================================================================

# =========================================================================
# SSL/TLS (future — uncomment when enabling HTTPS)
# Paths must be absolute. Cert and key must be readable by the process user.
# =========================================================================
# QUICKROBOT_API_SSL_CERT=/opt/quickrobot/certs/api.crt NOT IMPLEMENTED
# QUICKROBOT_API_SSL_KEY=/opt/quickrobot/certs/api.key NOT IMPLEMENTED
# QUICKROBOT_WEBUI_SSL_CERT=/opt/quickrobot/certs/webui.crt NOT IMPLEMENTED
# QUICKROBOT_WEBUI_SSL_KEY=/opt/quickrobot/certs/webui.key NOT IMPLEMENTED
# QUICKROBOT_MCP_SSL_CERT=/opt/quickrobot/certs/mcp.crt NOT IMPLEMENTED
# QUICKROBOT_MCP_SSL_KEY=/opt/quickrobot/certs/mcp.key NOT IMPLEMENTED
# =========================================================================

